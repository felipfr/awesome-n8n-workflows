            "Demande": "={{ $json.message }}",
            "Statut": "Reçu"
          }
        }
      }
    },
    {
      "id": "801c3324-7ea0-46ea-a557-cdced9c3c585",
      "name": "Préparer prompt",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [
        840,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1eb52c8a-6b19-428e-b20d-8ee59241cf88",
              "name": "prompt",
              "type": "string",
              "value": "=Analyse cette demande et retourne UNIQUEMENT un JSON: {\"dans_perimetre\": true/false, \"score\": 1-10, \"resume\": \"...\"}. Périmètre: consulting IA pour PME. Demande: {{ $('Extraire champs').item.json.message }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1bbb87ca-357f-4ec1-ac1e-d5c294c78520",
      "name": "Claude — Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1040,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "specifyBody": "json",
        "jsonBody": "={\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":512,\"messages\":[{\"role\":\"user\",\"content\":{{ JSON.stringify($json.prompt) }}}]}",
        "options": {}
      }
    },
    {
      "id": "d714edca-91c1-465f-be7d-eda8b906a78e",
      "name": "Parser JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "jsCode": "const txt = $json.content[0].text;\nlet parsed;\ntry { parsed = JSON.parse(txt); }\ncatch (e) {\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  parsed = m ? JSON.parse(m[0]) : { dans_perimetre: false, score: 0, resume: txt };\n}\nconst e = $('Extraire champs').item.json;\nreturn [{ json: { dans_perimetre: parsed.dans_perimetre === true, score: parsed.score, resume: parsed.resume, nom: e.nom, email: e.email, message: e.message } }];"
      }
    },
    {
      "id": "941e9f37-9caa-4e71-b3ce-b9decc6a381b",
      "name": "Switch périmètre",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.dans_perimetre }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ]
              },
              "outputKey": "dans_perimetre"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.dans_perimetre }}",
                    "rightValue": false,
                    "operator": {
                      "type": "boolean",
                      "operation": "false",
                      "singleValue": true
                    }
                  }
                ]
              },
              "outputKey": "hors_perimetre"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "045ce797-bef7-4aac-9d78-ec784f08d2fb",
