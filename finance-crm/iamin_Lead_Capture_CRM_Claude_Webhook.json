        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "cc3f2b88-a1ad-4b9b-b6f0-6c86add69035",
      "name": "Extraire champs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
